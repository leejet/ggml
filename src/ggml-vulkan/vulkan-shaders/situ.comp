#version 450

#include "glu_head.glsl"

shared float scaled_up_values[512];

float op(float gate, float up) {
    // Match the separate Vulkan scale/tanh/sigmoid passes, including their tanh expression.
    precise float scaled_gate = gate * 0.25f;
    precise float capped_gate = (1.0f - 2.0f / (exp(2.0f * scaled_gate) + 1.0f)) * 4.0f;
    precise float sigmoid_gate = 1.0f / (1.0f + exp(-gate));
    precise float activated_gate = capped_gate * sigmoid_gate;
    // A storage round-trip keeps the scale from being folded into the exponential argument.
    scaled_up_values[gl_LocalInvocationIndex] = up * (1.0f / 25.0f);
    memoryBarrierShared();
    precise float scaled_up = scaled_up_values[gl_LocalInvocationIndex];
    precise float capped_up = (1.0f - 2.0f / (exp(2.0f * scaled_up) + 1.0f)) * 25.0f;
    precise float result = activated_gate * capped_up;
    return result;
}

#include "glu_main.glsl"
